# Copy to .env.local (never commit it) and fill in from Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key or the newer "publishable" key. Both are safe to ship in the browser: access is enforced by RLS.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=

# GitHub Pages project site: set to /<repo-name>/ (the deploy workflow does this for you)
VITE_BASE=/
